LOG_FILE="$HOME/sentinel/sentinel.log"
STATE_DIR="$HOME/sentinel/state"
WEB_DIR=/var/www/sentinel
HISTORY_FILE="$STATE_DIR/history.csv"
CHECKS_DIR="$HOME/sentinel/checks.d"
LOCK_FILE="/tmp/sentinel.lock"
DISK_WARN=80
DISK_CRIT=90
MEM_WARN=20
MEM_CRIT=10
CONFIRM_AFTER=3
COOLDOWN=1800
ALERT_EMAIL="96987142+VincentTeti@users.noreply.github.com"
DRY_RUN=1
AUTO_HEAL=1
HEAL_MAX=3
HEAL_WINDOW=3600
LOAD_WARN=1.0
LOAD_CRIT=2.0
HTTP_URL="http://localhost:8080"
NGINX_ACCESS_LOG=/var/log/nginx/access.log
ERR5XX_WARN=5
ERR5XX_CRIT=20
